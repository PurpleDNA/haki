# Postgres connection string. In production use the Supabase transaction pooler URL.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5433/postgres
# At least 32 random characters: openssl rand -base64 48
SESSION_SECRET=
# Public address of the app, used in emailed links.
APP_URL=http://localhost:3000
# Optional. With no key, the app skips sending email and logs the attempt.
RESEND_API_KEY=
EMAIL_FROM=Haki <no-reply@example.com>
